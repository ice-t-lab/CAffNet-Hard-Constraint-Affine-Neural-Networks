{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario Config",
  "description": "Shared schema for scenario configuration files.",
  "type": "object",
  "required": ["scenario", "system", "net", "simulation", "visualization"],
  "properties": {
    "scenario": {
      "description": "Scenario identifier and name.",
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"}
        }
      },
    "system": {
      "description": "Problem or dynamical-system dimensions and scenario-specific system settings.",
      "type": "object",
      "required": ["x_dim", "y_dim"],
      "properties": {
        "x_dim": {
          "type": "integer",
          "minimum": 1
        },
        "y_dim": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "net": {
      "description": "Neural network architecture settings shared by comparable methods.",
      "type": "object",
      "required": ["ff", "tf"],
      "properties": {
        "default": {
          "description": "Default architecture family used when a method does not specify one explicitly.",
          "type": "string",
          "enum": ["ff", "tf"]
        },
        "ff": {
          "description": "Feedforward network architecture. The number of hidden layers is len(hidden_dims).",
          "type": "object",
          "required": ["hidden_dims", "activation"],
          "properties": {
            "hidden_dims": {
              "description": "Width of each hidden layer, for example [200, 200, 200].",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "activation": {
              "type": "string",
              "enum": ["relu"]
            },
            "dropout": {
              "description": "Dropout probability applied after hidden layers.",
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "tf": {
          "description": "Transformer architecture settings.",
          "type": "object",
          "required": ["d_model", "num_heads", "activation"],
          "properties": {
            "d_model": {
              "type": "integer",
              "minimum": 1
            },
            "num_heads": {
              "type": "integer",
              "minimum": 1
            },
            "activation": {
              "type": "string",
              "enum": ["relu"]
            },
            "dropout": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          }
        }
      }
    },
    "simulation": {
      "description": "Settings for data generation, training, logging, artifact saving, and rollout.",
      "type": "object",
      "required": ["seed", "data", "training", "logging", "save"],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "required": ["n_train", "n_eval"],
          "properties": {
            "n_train": {
              "type": "integer",
              "minimum": 2
            },
            "n_eval": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "training": {
          "type": "object",
          "required": ["lr", "n_epochs", "batch_size", "soft_weight"],
          "properties": {
            "lr": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "n_epochs": {
              "type": "integer",
              "minimum": 1
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "soft_weight": {
              "type": "number",
              "minimum": 0
            },
            "resume": {
              "description": "Whether to resume training from the latest saved run state.",
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "logging": {
          "type": "object",
          "required": ["log_freq", "save_freq"],
          "properties": {
            "log_freq": {
              "type": "integer",
              "minimum": 1
            },
            "save_freq": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "save": {
          "description": "Boolean toggles for artifacts saved during or after a run.",
          "type": "object",
          "properties": {
            "config": {
              "description": "Resolved config used for the run.",
              "type": "boolean"
            },
            "training_samples": {
              "description": "Training inputs and labels, if labels exist.",
              "type": "boolean"
            },
            "evaluation_samples": {
              "description": "Evaluation inputs and labels, if labels exist.",
              "type": "boolean"
            },
            "model_state": {
              "description": "Network state_dict.",
              "type": "boolean"
            },
            "optimizer_state": {
              "description": "Optimizer state for resumable training.",
              "type": "boolean"
            },
            "rng_state": {
              "description": "Python, NumPy, and torch random-number generator states.",
              "type": "boolean"
            },
            "loss_history": {
              "description": "Stored loss curves and loss terms.",
              "type": "boolean"
            },
            "predictions": {
              "description": "Model predictions on selected datasets.",
              "type": "boolean"
            },
            "controls": {
              "description": "Control inputs or trajectories, mainly for CBF/control scenarios.",
              "type": "boolean"
            },
            "metrics": {
              "description": "Evaluation metrics and summary tables.",
              "type": "boolean"
            },
            "figures": {
              "description": "Generated plots.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "rollout": {
          "description": "Optional trajectory rollout settings, mainly used by CBF scenarios.",
          "type": "object",
          "properties": {
            "dt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "t_train": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "t_eval": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "x_0": {
              "type": "array"
            }
          },
          "additionalProperties": true
        },
        "cost": {
          "description": "Optional cost weights, mainly used by CBF scenarios.",
          "type": "object",
          "properties": {
            "Q": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "R": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "Qf": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": true
        },
        "controller": {
          "description": "Optional controller gains or controller-specific settings.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "visualization": {
      "description": "Plotting options grouped by output type.",
      "type": "object",
      "properties": {
        "problem": {
          "type": "object",
          "properties": {
            "figsize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "dpi": {"type": "number", "exclusiveMinimum": 0},
            "xlim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "ylim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "xlabel": {"type": "string"},
            "ylabel": {"type": "string"},
            "title": {"type": "string"},
            "grid": {"type": "boolean"},
            "aspect": {"type": "string"},
            "label_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "tick_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "title_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_loc": {"type": "string"},
            "legend_ncol": {"type": "integer", "minimum": 1},
            "legend_frameon": {"type": "boolean"},
            "obstacle_label_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "show_sample_heading": {"type": "boolean"},
            "sample_heading_stride": {"type": "integer", "minimum": 1},
            "sample_heading_length": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        },
        "result": {
          "type": "object",
          "properties": {
            "figsize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "dpi": {"type": "number", "exclusiveMinimum": 0},
            "xlim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "ylim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "xlabel": {"type": "string"},
            "ylabel": {"type": "string"},
            "grid": {"type": "boolean"},
            "label_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "tick_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_loc": {"type": "string"},
            "legend_ncol": {"type": "integer", "minimum": 1},
            "legend_frameon": {"type": "boolean"},
            "color": {"type": "string"},
            "linestyle": {"type": "string"},
            "linewidth": {"type": "number", "minimum": 0},
            "alpha": {"type": "number", "minimum": 0, "maximum": 1},
            "method_styles": {
              "description": "Optional per-method figure style overrides keyed by method name.",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "control": {
          "description": "Optional control-input plot, mainly used by CBF scenarios.",
          "type": "object",
          "properties": {
            "figsize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "dpi": {"type": "number", "exclusiveMinimum": 0},
            "xlim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "ylim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "y_tick_format": {"type": "string"},
            "label_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "tick_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_loc": {"type": "string"},
            "legend_ncol": {"type": "integer", "minimum": 1},
            "legend_frameon": {"type": "boolean"},
            "nominal_style": {
              "type": "object",
              "additionalProperties": true
            },
            "method_styles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "constraint_style": {
              "type": "object",
              "additionalProperties": true
            },
            "constraint_fill": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "loss_history": {
          "type": "object",
          "properties": {
            "figsize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "dpi": {"type": "number", "exclusiveMinimum": 0},
            "label_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "tick_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "title_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "legend_fontsize": {"type": "number", "exclusiveMinimum": 0},
            "first_n_epochs": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "ylim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "linewidth": {"type": "number", "minimum": 0},
            "alpha": {"type": "number", "minimum": 0, "maximum": 1},
            "method_styles": {
              "description": "Optional per-method loss-plot style overrides keyed by method name.",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "animation": {
          "type": "object",
          "properties": {
            "figsize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "dpi": {"type": "number", "exclusiveMinimum": 0},
            "xlim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "ylim": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "interval": {
              "type": "integer",
              "minimum": 1
            },
            "repeat": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
