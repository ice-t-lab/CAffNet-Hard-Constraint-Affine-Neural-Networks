BootStrap: docker
From: nvidia/cuda:12.6.2-cudnn-runtime-ubuntu22.04

%files
    requirements.txt /opt/requirements.txt

%post
    /bin/bash -lc '
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    export TMPDIR=/var/tmp
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

    mkdir -p /etc /var /var/tmp /tmp
    chmod 1777 /tmp /var/tmp || true

    mkdir -p /var/lib/apt/lists/partial /var/cache/apt/archives/partial
    rm -rf /var/lib/apt/lists/* && mkdir -p /var/lib/apt/lists/partial

    apt-get clean
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        python3 python3-pip python3-venv python3-dev \
        build-essential \
        libgl1 libglib2.0-0 libsm6 libxrender1 libxext6 \
        ffmpeg
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # PyTorch (CUDA 12.6 wheels)
    python3 -m pip install --no-cache-dir \
        torch torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126

    # Your project requirements
    ls -l /opt/requirements.txt
    python3 -m pip install --no-cache-dir -r /opt/requirements.txt

    rm -f /opt/requirements.txt
    '

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

%runscript
    exec python3 "$@"